generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int             @id @default(autoincrement())
  nama           String          @db.VarChar(100)
  email          String          @unique @db.VarChar(255)
  password       String          @db.VarChar(255)
  avatar         String?         @db.Text
  cityName       String?         @map("city_name") @db.VarChar(100)
  cityLatitude   Float?          @map("city_latitude")
  cityLongitude  Float?          @map("city_longitude")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  communityPosts CommunityPost[]
  riskAnalyses   RiskAnalysis[]

  @@map("users")
}

enum RiskCategory {
  RENDAH
  SEDANG
  SEDANG_TINGGI
  TINGGI
  SANGAT_TINGGI
}

enum GeminiGenerationStatus {
  PENDING
  COMPLETED
  FAILED
}

model RiskAnalysis {
  id                  Int          @id @default(autoincrement())
  userId              Int          @map("user_id")
  locationName        String?      @map("location_name") @db.VarChar(150)
  latitude            Float
  longitude           Float
  vulnerabilityScore  Float        @map("vulnerability_score")
  category            RiskCategory
  freqPerYear         Float        @map("freq_per_year")
  m5Count             Int          @map("m5_count")
  maxMagnitude        Float        @map("max_magnitude")
  avgDepthKm          Float        @map("avg_depth_km")
  nearestM5DistanceKm Float        @map("nearest_m5_distance_km")
  modelName           String       @default("SIGAP-ML") @map("model_name") @db.VarChar(100)
  modelVersion        String?      @map("model_version") @db.VarChar(50)
  rawMlOutput         Json?        @map("raw_ml_output")
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  geminiAdvice GeminiAdvice?

  @@index([userId, createdAt])
  @@index([latitude, longitude])
  @@map("risk_analyses")
}

model GeminiAdvice {
  id               Int                    @id @default(autoincrement())
  riskAnalysisId   Int                    @unique @map("risk_analysis_id")
  status           GeminiGenerationStatus @default(PENDING)
  modelName        String                 @default("gemini-3.6-flash") @map("model_name") @db.VarChar(100)
  promptVersion    String                 @default("risk-advice-v1") @map("prompt_version") @db.VarChar(50)
  structuredOutput Json?                  @map("structured_output")
  rawResponse      Json?                  @map("raw_response")
  errorMessage     String?                @map("error_message") @db.Text
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  riskAnalysis RiskAnalysis @relation(fields: [riskAnalysisId], references: [id], onDelete: Cascade)

  @@map("gemini_advices")
}

model CommunityPost {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  title         String   @db.VarChar(200)
  description   String   @db.Text
  locationName  String   @map("location_name") @db.VarChar(150)
  latitude      Float?
  longitude     Float?
  damageLevel   String   @default("RINGAN") @map("damage_level") @db.VarChar(20)
  imageUrl      String?  @map("image_url") @db.Text
  verifiedCount Int      @default(0) @map("verified_count")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("community_posts")
}
